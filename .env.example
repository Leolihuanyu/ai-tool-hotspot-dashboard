# === LLM API配置 ===
# 选择其一配置：

# 方案1：使用OpenAI（推荐，价格更低）
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxx
LLM_PROVIDER=openai
LLM_MODEL=gpt-3.5-turbo  # 或 gpt-4o (更智能但更贵)

# 方案2：使用Claude（research.md推荐）
# ANTHROPIC_API_KEY=<ANTHROPIC_API_KEY>
# LLM_PROVIDER=claude
# LLM_MODEL=claude-haiku-3-20240307
LLM_USE_BATCH_API=true  # 开启Batch API以节省50%成本

# === 邮件服务配置 ===
# 邮件发送方式选择: smtp 或 sendgrid
EMAIL_PROVIDER=smtp

# --- 方案1: SMTP邮箱（推荐，免费简单）---
# Gmail配置（需要应用专用密码）
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=你的邮箱@gmail.com
SMTP_PASSWORD=应用专用密码（16位，去掉空格）
SMTP_USE_TLS=true

# QQ邮箱配置（需要授权码）
# SMTP_SERVER=smtp.qq.com
# SMTP_PORT=587
# SMTP_USERNAME=你的QQ号@qq.com
# SMTP_PASSWORD=QQ邮箱授权码
# SMTP_USE_TLS=true

# 163邮箱配置（需要授权码）
# SMTP_SERVER=smtp.163.com
# SMTP_PORT=465
# SMTP_USERNAME=你的邮箱@163.com
# SMTP_PASSWORD=163邮箱授权码
# SMTP_USE_TLS=false

# iCloud邮箱配置（需要专用App密码）
# SMTP_SERVER=smtp.mail.me.com
# SMTP_PORT=587
# SMTP_USERNAME=你的邮箱@icloud.com
# SMTP_PASSWORD=iCloud专用App密码
# SMTP_USE_TLS=true

# --- 方案2: SendGrid（专业服务，需注册）---
# 如果使用SendGrid，请设置 EMAIL_PROVIDER=sendgrid 并配置以下项：
# SENDGRID_API_KEY=SG.xxxxxxxxxxxxx

# 发件人和收件人配置（两种方式都需要）
# 注意：使用SendGrid域名认证后，可以使用自定义域名邮箱（如 noreply@yourdomain.com）
EMAIL_FROM=noreply@jereo.co.jp
EMAIL_TO_LIST=收件人1@example.com,收件人2@example.com

# 邮件发送时间（cron格式，默认每天早上8点）
EMAIL_SCHEDULE_CRON="0 8 * * *"

# === 数据库配置 ===
# 数据库类型选择（sqlite 或 postgresql）
DB_TYPE=sqlite  # 本地开发使用 sqlite，生产环境使用 postgresql

# SQLite配置（本地开发）
DATABASE_PATH=data/dashboard.db

# PostgreSQL配置（生产环境：Supabase/Neon/Railway等）
# 注意：DATABASE_URL 格式为 <DATABASE_URL>
# 示例：<DATABASE_URL>
# DATABASE_URL=<DATABASE_URL>

# === 数据抓取配置 ===
# 速率限制（遵守宪法I：≤1 req/sec per domain）
SCRAPER_RATE_LIMIT=1.0  # 秒/请求
SCRAPER_MAX_RETRIES=3
SCRAPER_TIMEOUT=10  # 秒

# === 爬虫启用/禁用配置 ===
# AI工具爬虫
ENABLE_SCRAPER_FUTUREPEDIA=true  # RSS feed，高质量
ENABLE_SCRAPER_PRODUCTHUNT=true  # GraphQL API，高质量
ENABLE_SCRAPER_THERESANAI=false  # 可能需要JS渲染，默认禁用（已有2个高质量源）

# 热点趋势爬虫
ENABLE_SCRAPER_REDDIT=true  # PRAW API，核心数据源
ENABLE_SCRAPER_HACKERNEWS=true  # 官方API，极高质量
ENABLE_SCRAPER_GITHUB=true  # GraphQL API，开发者痛点
ENABLE_SCRAPER_TIKTOK=true  # RapidAPI/RSS
ENABLE_SCRAPER_YOUTUBE=true  # 官方API
ENABLE_SCRAPER_X_TWITTER=true  # Nitter RSS
ENABLE_SCRAPER_GOOGLE_TRENDS=true  # pytrends库

# === 评分权重配置（research.md评分算法）===
SCORE_WEIGHT_PAIN_CLARITY=0.4
SCORE_WEIGHT_MVP_SPEED=0.3
SCORE_WEIGHT_MONETIZATION=0.3
SCORE_WEIGHT_JAPAN_MARKET=0.2
SCORE_WEIGHT_US_EU_MARKET=0.2
SCORE_WEIGHT_TRENDING=0.3

# === Flask配置 ===
FLASK_ENV=development
FLASK_DEBUG=true
FLASK_PORT=5000

# Dashboard URL（用于邮件链接等）
# 本地开发: http://127.0.0.1:5000
# 生产环境: https://your-app.onrender.com
DASHBOARD_URL=http://127.0.0.1:5000

# GitHub数据URL（Dashboard从此URL获取最新数据）
# 这是为了解决Render免费部署容器无法持久化存储数据的问题
# 默认: https://raw.githubusercontent.com/你的用户名/ai-tool-hotspot-dashboard/main/data/latest.json
# 注意：请替换为你自己的GitHub仓库地址
GITHUB_DATA_URL=https://raw.githubusercontent.com/Leolihuanyu/ai-tool-hotspot-dashboard/main/data/latest.json

# === 高信号数据源API配置 ===

# Reddit API配置（推荐配置 - 用于抓取高质量痛点）
# 注册地址：https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=your_client_id
REDDIT_CLIENT_SECRET=your_client_secret
REDDIT_USER_AGENT=AI-Opportunity-Matcher/1.0

# GitHub Token配置（推荐配置 - 用于抓取Discussions中的feature requests）
# 生成地址：https://github.com/settings/tokens
# 需要权限：public_repo, read:discussion
GITHUB_TOKEN=<GITHUB_TOKEN>

# Hacker News（无需配置 - 使用官方公开API）
# API文档：https://github.com/HackerNews/API

# === 日志配置 ===
LOG_LEVEL=INFO
LOG_FORMAT=json  # json 或 text

# === 访问控制配置（JWT Token）===
# JWT密钥（用于生成和验证访问token）
# 重要：生产环境必须使用强随机密钥！可以使用以下命令生成：
# python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=your-super-secret-key-change-in-production

# Token有效期（小时）
TOKEN_EXPIRY_HOURS=24

# 是否启用IP地址验证（防止token被转发）
# true: 严格模式，token只能从生成时的IP访问
# false: 宽松模式，允许不同IP访问（推荐，避免移动网络切换问题）
TOKEN_REQUIRE_IP_MATCH=false

# Dashboard基础URL（用于生成邮件中的访问链接）
DASHBOARD_BASE_URL=https://ai-tool-hotspot-dashboard.vercel.app

# === Stripe支付配置（可选，用于付费订阅）===
# Stripe密钥（生产环境）
# 注册地址：https://dashboard.stripe.com/register
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxxxxxxxxxxxxxx

# Stripe测试环境密钥（开发时使用）
# STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
# STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# Stripe价格ID（创建产品后获得）
# 月付订阅
STRIPE_PRICE_ID_MONTHLY=price_xxxxxxxxxxxxxxxx
# 年付订阅
STRIPE_PRICE_ID_YEARLY=price_xxxxxxxxxxxxxxxx

# Webhook密钥（用于验证Stripe回调）
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx
