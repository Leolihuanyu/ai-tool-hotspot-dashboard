# Frontend Environment Variables

# ========== 数据源配置 ==========
# 数据URL - 生产环境使用GitHub Raw URL，开发环境可以使用本地代理
# 生产环境（从GitHub读取）:
VITE_DATA_URL=https://raw.githubusercontent.com/Leolihuanyu/ai-tool-hotspot-dashboard/main/data/latest.json

# 开发环境（从本地Flask后端读取，需要启动Flask服务）:
# VITE_DATA_URL=/data/latest.json

# ========== API配置 ==========
# API基础URL - 用于认证、支付等后端API调用
# 生产环境（Vercel部署后，指向Render后端）:
# VITE_API_BASE_URL=https://your-backend.onrender.com

# 开发环境（本地Flask服务）:
VITE_API_BASE_URL=http://127.0.0.1:8010

# ========== 其他配置 ==========
# 是否启用调试模式
VITE_DEBUG=false
