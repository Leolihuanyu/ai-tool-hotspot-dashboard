# Frontend Environment Variables - Production

# ========== 数据源配置 ==========
# 生产环境：从GitHub Raw读取数据
VITE_DATA_URL=https://raw.githubusercontent.com/Leolihuanyu/ai-tool-hotspot-dashboard/main/data/latest.json

# ========== API配置 ==========
# 生产环境：指向Render.com上的Flask后端
VITE_API_BASE_URL=https://ai-tool-hotspot-dashboard.onrender.com

# ========== 其他配置 ==========
# 禁用调试模式
VITE_DEBUG=false
