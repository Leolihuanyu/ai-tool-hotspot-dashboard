################################################################################
# AI Tool Hotspot Dashboard - Cron配置示例
#
# 使用方法：
# 1. 编辑此文件，替换路径为实际路径
# 2. 执行: crontab -e
# 3. 将下面的行复制到crontab编辑器中
# 4. 保存并退出
#
# 查看当前cron任务: crontab -l
# 删除所有cron任务: crontab -r
################################################################################

# 环境变量（可选，如果脚本中已设置则无需）
PATH=/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin
SHELL=/bin/bash

# ============================================================================
# 定时任务配置
# ============================================================================

# 每天早上8:00执行
0 8 * * * /Users/ri/Projects/ai-tool-hotspot-dashboard/scripts/run_daily_pipeline.sh >> /Users/ri/Projects/ai-tool-hotspot-dashboard/logs/cron/cron.log 2>&1

# 其他时间选项示例：
# 每天中午12:00执行
# 0 12 * * * /Users/ri/Projects/ai-tool-hotspot-dashboard/scripts/run_daily_pipeline.sh

# 每天早上8:00和下午18:00执行（一天两次）
# 0 8,18 * * * /Users/ri/Projects/ai-tool-hotspot-dashboard/scripts/run_daily_pipeline.sh

# 每周一早上8:00执行
# 0 8 * * 1 /Users/ri/Projects/ai-tool-hotspot-dashboard/scripts/run_daily_pipeline.sh

# 每月1号早上8:00执行
# 0 8 1 * * /Users/ri/Projects/ai-tool-hotspot-dashboard/scripts/run_daily_pipeline.sh

################################################################################
# Cron时间格式说明
# ┌─────────── 分钟 (0 - 59)
# │ ┌───────── 小时 (0 - 23)
# │ │ ┌─────── 日期 (1 - 31)
# │ │ │ ┌───── 月份 (1 - 12)
# │ │ │ │ ┌─── 星期 (0 - 7, 0和7都代表星期日)
# │ │ │ │ │
# * * * * * command
################################################################################
